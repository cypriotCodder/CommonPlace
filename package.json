{
  "name": "commonplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "predev": "node scripts/prepare-db.cjs",
    "prestart": "node scripts/prepare-db.cjs",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "workflow:n8n": "node scripts/build-n8n-workflow.mjs",
    "n8n:check": "node scripts/check-n8n-webhook.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "htmlparser2": "12.0.0",
    "next": "^15.5.28",
    "pdfjs-dist": "6.4.299",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
