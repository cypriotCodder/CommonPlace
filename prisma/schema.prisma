generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ConceptProgress {
  conceptId String @id
  notes String @default("")
  read Boolean @default(false)
  practice Boolean @default(false)
}

model PracticeAttempt {
  id String @id @default(cuid())
  conceptId String
  challengeId String @default("index-query-choice")
  choice String
  createdAt DateTime @default(now())
}

model ReviewCard {
  cardId String @id
  dueAt DateTime
}

model ReviewEvent {
  id String @id @default(cuid())
  cardId String
  outcome String
  createdAt DateTime @default(now())
}

model MigrationMarker {
  id String @id
  createdAt DateTime @default(now())
}

model Book {
  id String @id
  title String
  author String @default("")
  format String
  checksum String @unique
  status String @default("extracting")
  progress Int @default(0)
  total Int @default(0)
  error String?
  keepPassages Boolean?
  createdAt DateTime @default(now())
  units TextUnit[]
  passages Passage[]
  aiRuns AiRun[]
}

model TextUnit {
  id String @id
  bookId String
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ordinal Int
  location String
  text String
  passages Passage[]
  suggestions AiSuggestion[]
  @@unique([bookId, ordinal])
}

model Passage {
  id String @id @default(cuid())
  conceptId String
  bookId String?
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  unitId String?
  unit TextUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  start Int
  end Int
  quote String
  title String
  author String @default("")
  location String
  createdAt DateTime @default(now())
  material StudyMaterial?
  @@index([conceptId, createdAt])
}

model AiRun {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topic String
  status String @default("running")
  batches Int @default(0)
  totalChunks Int @default(0)
  nextChunk Int @default(0)
  completed Int @default(0)
  skipped Int @default(0)
  error String?
  createdAt DateTime @default(now())
  suggestions AiSuggestion[]
  @@index([bookId, createdAt])
}

model AiSuggestion {
  id String @id @default(cuid())
  runId String
  run AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  unitId String
  unit TextUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  start Int
  end Int
  quote String
  reason String
  timeSensitive Boolean @default(false)
  freshnessNote String @default("")
  title String
  question String
  answer String
  prompt String
  choices Json
  correctChoice String
  explanation String
  status String @default("draft")
  materialId String? @unique
  material StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@unique([runId, unitId, start, end])
}

model StudyMaterial {
  id String @id @default(cuid())
  passageId String @unique
  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  title String
  topic String
  timeSensitive Boolean @default(false)
  freshnessNote String @default("")
  verifiedSource String?
  checkedAt DateTime?
  question String
  answer String
  prompt String
  choices Json
  correctChoice String
  explanation String
  createdAt DateTime @default(now())
  suggestion AiSuggestion?
}
