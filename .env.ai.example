# Copy these settings to ignored .env.local after choosing a provider in n8n.
# Use the production webhook URL, not /webhook-test/.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/commonplace-book-study
# Generate a random token locally; use the same value in n8n's Header Auth credential.
N8N_WEBHOOK_TOKEN=
# The provider/model actually configured in the n8n workflow. Leave empty until selected.
N8N_AI_PROVIDER=
